# -----------------------------------------------------------------------------
# Aarla OS database (Supabase Postgres)
# Same project / same credentials as aarla-os on Vercel.
# Kelvi tables live in schema `kelvi` — public OS / commerce tables are untouched.
# See docs/supabase-vercel.md in aarla-os.
# -----------------------------------------------------------------------------
# Transaction pooler — app runtime (port 6543). From Supabase → Connect.
# On Vercel this is the only required DB var (same value as aarla-os).
# Session-pooler :5432 URIs are rewritten to :6543 unless DATABASE_POOL_MODE=session.
DATABASE_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Optional. Session pooler for Prisma CLI. If omitted, Kelvi derives :5432 from DATABASE_URL.
# DIRECT_URL="postgresql://postgres.YOUR_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional alias used by Aarla OS
# SUPABASE_DB_URL=
# DATABASE_POOL_MODE=transaction

AUTH_SECRET="replace-with-a-32-byte-secret"
# Required on Vercel for /setup (AUTH_SECRET is sensitive and cannot be revealed).
# Copy this value somewhere before saving — Vercel will not show it again.
# SETUP_SECRET="a-long-phrase-you-choose"
AUTH_TRUST_HOST="true"
AUTH_DEMO="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHARE_URL="https://play.aarla.com/k"
# Optional. On Vercel, leave AUTH_URL unset (or matching the real host).
# A leftover localhost AUTH_URL makes Auth.js report Configuration.
# AUTH_URL=

# Optional OAuth. Kelvi never requires Instagram to play.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_ID=
# APPLE_SECRET=

# Vercel Cron. Sent as Authorization: Bearer CRON_SECRET at 10:00 PM IST (16:30 UTC).
# CRON_SECRET=

# Optional Instagram Graph publish of tonight's winners image.
# handle|ig-user-id|access-token, comma or newline separated.
# Posts to aarla.play, aarla.kanakangi, aarla.merch when those three rows are present.
# INSTAGRAM_PUBLISH_ACCOUNTS="aarla.play|IG_USER_ID|TOKEN,aarla.kanakangi|IG_USER_ID|TOKEN,aarla.merch|IG_USER_ID|TOKEN"
# INSTAGRAM_GRAPH_HOST="https://graph.facebook.com"
# INSTAGRAM_GRAPH_VERSION="v21.0"
